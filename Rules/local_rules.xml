<!-- Custom Wazuh SIEM Detection Rules -->

<group name="local,syslog,sshd,">

    <!-- Rule 100100: Multiple Failed Windows Logins -->
    <rule id="100100" level="10" frequency="5" timeframe="120" ignore="60">
        <if_matched_sid>60122</if_matched_sid>
        <same_field>win.eventdata.targetUserName</same_field>
        <description>Multiple failed Windows logins for the same account within 2 minutes.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
    </rule>

    <!-- Rule 100101: PowerShell Invoke-Expression Detection -->
    <rule id="100101" level="5">
        <if_sid>91802</if_sid>
        <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(Invoke-Expression|\bIEX\b)</field>
        <description>PowerShell detected Invoke-Expression execution.</description>
        <mitre>
            <id>T1059.001</id>
        </mitre>
    </rule>

</group>
